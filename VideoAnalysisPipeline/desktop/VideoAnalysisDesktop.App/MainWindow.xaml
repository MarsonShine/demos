<Window x:Class="VideoAnalysisDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Video Analysis Desktop"
        Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Directory Selection -->
        <GroupBox Grid.Row="0" Header="Directory Selection" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Root:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputRoot}" IsReadOnly="True"
                         IsEnabled="{Binding CanChangePaths}" Margin="0,0,4,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseInputCommand}"
                        IsEnabled="{Binding CanChangePaths}" Width="80" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Output Root:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputRoot}" IsReadOnly="True"
                         IsEnabled="{Binding CanChangePaths}" Margin="0,0,4,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseOutputCommand}"
                        IsEnabled="{Binding CanChangePaths}" Width="80"/>
            </Grid>
        </GroupBox>

        <!-- Row 1: Preset Info + Preflight -->
        <GroupBox Grid.Row="1" Header="Preset: MOD 720p Android" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PresetDescription}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Button Grid.Column="1" Content="Run Preflight" Command="{Binding RunPreflightCommand}"
                        IsEnabled="{Binding CanChangePaths}" Width="100" VerticalAlignment="Top" Margin="8,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Row 2: Preflight Result -->
        <Border Grid.Row="2" Margin="0,0,0,8" Padding="8"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{Binding PreflightSummary}" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,4,0,0">
                    <Run Text="Items found: "/>
                    <Run Text="{Binding PreflightTotalItems}" FontWeight="Bold"/>
                    <Run Text=" | "/>
                    <Run Text="Status: "/>
                    <Run Text="{Binding PreflightPassed, StringFormat={}{0}}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Row 3: Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start" Command="{Binding StartJobCommand}"
                    IsEnabled="{Binding CanStart}" Width="80" Height="32" Margin="0,0,8,0"
                    Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                    Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancel" Command="{Binding CancelJobCommand}"
                    IsEnabled="{Binding CanCancel}" Width="80" Height="32" Margin="0,0,8,0"/>
            <Button Content="Continue Failed" Command="{Binding ResumeJobCommand}"
                    IsEnabled="{Binding CanResume}" Width="110" Height="32" Margin="0,0,8,0"/>
            <Button Content="Open Output" Command="{Binding OpenOutputFolderCommand}"
                    IsEnabled="{Binding CanOpenOutput}" Width="100" Height="32" Margin="0,0,8,0"/>
            <Button Content="Admin Settings" Command="{Binding OpenAdminSettingsCommand}"
                    IsEnabled="{Binding CanChangePaths}" Width="110" Height="32" HorizontalAlignment="Right" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Row 4: Progress -->
        <Border Grid.Row="4" Margin="0,0,0,8" Padding="8"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="14" FontWeight="Bold">
                        <Run Text="Status: "/>
                        <Run Text="{Binding StatusText}"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,4,0,0">
                        <Run Text="Progress: "/>
                        <Run Text="{Binding ProgressText}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock FontSize="12">
                        <Run Text="Stage: "/>
                        <Run Text="{Binding StageText}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Row 5: Determinate progress bar driven by JSONL pipeline events -->
        <ProgressBar Grid.Row="5" Height="6" Margin="0,0,0,8"
                     Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Row 6: Log Output -->
        <GroupBox Grid.Row="6" Header="Log" Margin="0,0,0,0">
            <ListBox ItemsSource="{Binding LogEntries}"
                     FontFamily="Consolas" FontSize="11"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
